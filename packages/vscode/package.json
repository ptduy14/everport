{
  "name": "everport-vscode",
  "displayName": "Everport",
  "description": "Stable public URLs for your local services, on a relay in your own Cloudflare account",
  "publisher": "everport-dev",
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptduy14/everport.git"
  },
  "homepage": "https://github.com/ptduy14/everport#readme",
  "bugs": {
    "url": "https://github.com/ptduy14/everport/issues"
  },
  "author": "ptduy14",
  "keywords": [
    "tunnel",
    "public url",
    "webhook",
    "localhost",
    "cloudflare"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "everport",
          "title": "Everport",
          "icon": "resources/everport.svg"
        }
      ]
    },
    "views": {
      "everport": [
        {
          "id": "everport.tunnels",
          "name": "Tunnels",
          "icon": "resources/everport.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "everport.tunnels",
        "contents": "Checking your setup…\nFinding Node.js and checking your Cloudflare login. The first time can take up to a minute while Cloudflare's tool downloads.",
        "when": "!everport.ready || (!everport.nodeMissing && !everport.statusError && !everport.loginKnown && !everport.loginError)"
      },
      {
        "view": "everport.tunnels",
        "contents": "Everport runs on Node.js 22.12 or newer. Pick one that is already on this computer, or install it.\n[Choose Node.js](command:everport.selectNode)\n[Check Again](command:everport.refresh)\nNo Node.js yet? [Download it](https://nodejs.org), then click Check Again.\nEverport looks on your PATH and in the folders of fnm, nvm and Volta.",
        "when": "everport.ready && everport.nodeMissing"
      },
      {
        "view": "everport.tunnels",
        "contents": "Everport couldn't read your tunnels. The log says why.\n[Show Log](command:everport.showLog)\n[Run Doctor](command:everport.doctor)\n[Check Again](command:everport.refresh)",
        "when": "everport.ready && !everport.nodeMissing && everport.statusError"
      },
      {
        "view": "everport.tunnels",
        "contents": "Couldn't reach Cloudflare to check your login. Check your internet connection, then try again.\n[Try Again](command:everport.refresh)\n[Log in to Cloudflare](command:everport.login)\nDetails are in the [log](command:everport.showLog).",
        "when": "everport.ready && !everport.nodeMissing && !everport.statusError && !everport.loginKnown && everport.loginError"
      },
      {
        "view": "everport.tunnels",
        "contents": "Give your local services public URLs that never change, served from your own Cloudflare account.\n[Log in to Cloudflare](command:everport.login)\nNo account? [Create one for free](https://dash.cloudflare.com/sign-up).\nLogin happens in your browser, through Cloudflare's own tool. Everport never sees your password.",
        "when": "everport.ready && !everport.nodeMissing && !everport.statusError && everport.loginKnown && !everport.loggedIn"
      },
      {
        "view": "everport.tunnels",
        "contents": "No tunnels yet. A tunnel gives a local port a public URL that never changes, even after you restart.\n[Add a Tunnel](command:everport.add)\nTunnels keep running when VS Code is closed.",
        "when": "everport.ready && !everport.nodeMissing && !everport.statusError && everport.loginKnown && everport.loggedIn"
      }
    ],
    "configuration": {
      "title": "Everport",
      "properties": {
        "everport.startOnOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start your tunnels when VS Code opens, if they are not already running. Off by default, because starting makes your local services public.",
          "scope": "application"
        },
        "everport.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Node.js (22.12 or newer) Everport runs on. Leave empty to pick one automatically. Easiest: run **Everport: Select Node.js**.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "everport.add",
        "title": "Add Tunnel",
        "category": "Everport",
        "icon": "$(add)"
      },
      {
        "command": "everport.upAll",
        "title": "Start All",
        "category": "Everport",
        "icon": "$(run-all)"
      },
      {
        "command": "everport.downAll",
        "title": "Stop All",
        "category": "Everport",
        "icon": "$(debug-stop)",
        "enablement": "everport.anyRunning"
      },
      {
        "command": "everport.refresh",
        "title": "Refresh",
        "category": "Everport",
        "icon": "$(refresh)"
      },
      {
        "command": "everport.doctor",
        "title": "Run Doctor",
        "category": "Everport"
      },
      {
        "command": "everport.selectNode",
        "title": "Select Node.js...",
        "category": "Everport"
      },
      {
        "command": "everport.showLog",
        "title": "Show Log",
        "category": "Everport",
        "icon": "$(output)"
      },
      {
        "command": "everport.login",
        "title": "Log in to Cloudflare…",
        "category": "Everport"
      },
      {
        "command": "everport.copyUrl",
        "title": "Copy URL",
        "category": "Everport",
        "icon": "$(copy)"
      },
      {
        "command": "everport.openUrl",
        "title": "Open in Browser",
        "category": "Everport",
        "icon": "$(globe)"
      },
      {
        "command": "everport.start",
        "title": "Start",
        "category": "Everport",
        "icon": "$(play)"
      },
      {
        "command": "everport.stop",
        "title": "Stop",
        "category": "Everport",
        "icon": "$(debug-stop)"
      },
      {
        "command": "everport.retry",
        "title": "Retry",
        "category": "Everport",
        "icon": "$(refresh)"
      },
      {
        "command": "everport.checkHealth",
        "title": "Check Health",
        "category": "Everport",
        "icon": "$(pulse)"
      },
      {
        "command": "everport.remove",
        "title": "Remove…",
        "category": "Everport",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "everport.add",
          "when": "view == everport.tunnels && everport.canManage",
          "group": "navigation@1"
        },
        {
          "command": "everport.upAll",
          "when": "view == everport.tunnels && everport.canManage && everport.hasTunnels",
          "group": "navigation@2"
        },
        {
          "command": "everport.downAll",
          "when": "view == everport.tunnels && everport.canManage && everport.hasTunnels",
          "group": "navigation@3"
        },
        {
          "command": "everport.refresh",
          "when": "view == everport.tunnels && !everport.canManage",
          "group": "navigation@4"
        },
        {
          "command": "everport.refresh",
          "when": "view == everport.tunnels && everport.canManage",
          "group": "1_more@1"
        },
        {
          "command": "everport.doctor",
          "when": "view == everport.tunnels",
          "group": "1_more@2"
        },
        {
          "command": "everport.showLog",
          "when": "view == everport.tunnels",
          "group": "1_more@3"
        },
        {
          "command": "everport.login",
          "when": "view == everport.tunnels && !everport.loggedIn",
          "group": "2_account@1"
        }
      ],
      "view/item/context": [
        {
          "command": "everport.start",
          "when": "view == everport.tunnels && viewItem == tunnel.on.offline",
          "group": "inline@0"
        },
        {
          "command": "everport.copyUrl",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.((on|off)(\\.unhealthy|\\.offline)?|busy)$/",
          "group": "inline@1"
        },
        {
          "command": "everport.openUrl",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.((on|off)(\\.unhealthy)?|busy)$/",
          "group": "inline@2"
        },
        {
          "command": "everport.stop",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.on(\\.unhealthy)?$/",
          "group": "inline@3"
        },
        {
          "command": "everport.start",
          "when": "view == everport.tunnels && viewItem == tunnel.off",
          "group": "inline@3"
        },
        {
          "command": "everport.retry",
          "when": "view == everport.tunnels && viewItem =~ /\\.failed/",
          "group": "inline@1"
        },
        {
          "command": "everport.showLog",
          "when": "view == everport.tunnels && viewItem =~ /\\.failed/",
          "group": "inline@2"
        },
        {
          "command": "everport.copyUrl",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.(on|off|busy)/",
          "group": "1_open@1"
        },
        {
          "command": "everport.openUrl",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.(on|off|busy)/",
          "group": "1_open@2"
        },
        {
          "command": "everport.start",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.(off|on\\.offline)/",
          "group": "2_state@1"
        },
        {
          "command": "everport.stop",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.on/",
          "group": "2_state@2"
        },
        {
          "command": "everport.retry",
          "when": "view == everport.tunnels && viewItem =~ /\\.failed/",
          "group": "2_state@3"
        },
        {
          "command": "everport.checkHealth",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.on(\\.unhealthy|\\.failed)?$/",
          "group": "3_tools@1"
        },
        {
          "command": "everport.showLog",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.(on|off)/",
          "group": "3_tools@2"
        },
        {
          "command": "everport.remove",
          "when": "view == everport.tunnels && viewItem =~ /^tunnel\\.(on|off)/",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "everport.copyUrl",
          "when": "false"
        },
        {
          "command": "everport.openUrl",
          "when": "false"
        },
        {
          "command": "everport.start",
          "when": "false"
        },
        {
          "command": "everport.stop",
          "when": "false"
        },
        {
          "command": "everport.retry",
          "when": "false"
        },
        {
          "command": "everport.checkHealth",
          "when": "false"
        },
        {
          "command": "everport.remove",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "test:vscode": "tsup && tsup --config tsup.test.config.ts && node test/run.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@everport/agent": "*",
    "@everport/core": "*",
    "@everport/relay": "*",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Everport settings are only read from your user settings, never from a workspace."
    }
  }
}
